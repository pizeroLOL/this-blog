---
import Icon from "./Icon.astro";
import PostMeta from "./PostMeta.astro";

type Props = {
  staggerIndex?: number;
  post: {
    id: string;
    data: {
      title: string;
      tags: string[];
      description: string;
      date: Date;
    };
  };
};
const { post, staggerIndex } = Astro.props;
const delay =
  staggerIndex === undefined
    ? undefined
    : { "animation-delay": `${80 + staggerIndex * 50}ms` };
---

<a
  href={`/blogs/${post.id}`}
  class="group m3-rise block w-full rounded-xl"
  style={delay}
>
  <article class="m3-card m3-card-interactive flex flex-col gap-3 p-4 group-active:scale-[0.995] sm:p-5">
    <div class="flex items-center gap-3">
      <h3 class="text-title flex-1 text-wrap">{post.data.title}</h3>
      <Icon
        name="chevron-right"
        class="text-on-surface-variant group-hover:text-primary ease-spring shrink-0 transition-transform duration-300 group-hover:translate-x-1"
      />
    </div>
    <PostMeta post={post} timeClass="ml-auto" />
    <p class="text-on-surface-variant">{post.data.description}</p>
  </article>
</a>
