---
import Icon from "./Icon.astro";
import timeFormat from "../scripts/timeFormat";

type Props = {
  post: {
    id: string;
    data: {
      title: string;
      tags: string[];
      description: string;
      date: Date;
    };
  };
};
const post = Astro.props.post;
---

<a href={`/blogs/${post.id}`} class="group block w-full rounded-xl">
  <article
    class="m3-card m3-card-interactive flex flex-col gap-3 p-4 group-active:scale-[0.995] sm:p-5"
  >
    <div class="flex items-center gap-3">
      <h3 class="text-title flex-1 text-wrap">{post.data.title}</h3>
      <Icon
        name="chevron-right"
        class="text-on-surface-variant group-hover:text-primary ease-spring shrink-0 transition-transform duration-300 group-hover:translate-x-1"
      />
    </div>
    <div class="flex flex-wrap items-center gap-2">
      {
        post.data.tags.map((tag) => (
          <span class="m3-chip m3-chip-tonal">{tag}</span>
        ))
      }
      <time
        class="text-label text-on-surface-variant ml-auto tabular-nums"
        datetime={post.data.date.toISOString()}
      >
        {timeFormat(post.data.date)}
      </time>
    </div>
    <p class="text-on-surface-variant">{post.data.description}</p>
  </article>
</a>
