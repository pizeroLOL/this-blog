---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import config from "../../indexConfig.json";
import Icon from "../components/Icon.astro";
import PostBlock from "../components/PostBlock.astro";
import Base from "../layouts/Base.astro";
import WebInfo from "../components/WebInfo.astro";
import OnlineStatus from "../components/solidjs/OnlineStatus";
import luoxi from "../assets/luoxi.jpg";

const posts = await getCollection("blogs");
const visiblePosts = (
  import.meta.env.DEV
    ? posts
    : posts.filter((post) => !post.data.tags.includes("测试"))
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base
  title="主页"
  description="Pizero 的个人博客"
  keywords={["blog", "pizero", "博客"]}
>
  <header class="m3-top-bar">
    <div class="mx-auto flex h-16 max-w-[64rem] items-center gap-2 px-4">
      <a href="/" class="flex items-center gap-3" aria-label="pizero 首页">
        <span
          class="bg-primary-container text-on-primary-container grid size-9 place-items-center rounded-[10px] font-mono text-xs font-bold"
        >
          &gt;_&lt;
        </span>
        <span class="text-title">pizero</span>
      </a>
      <span class="flex-1"></span>
      <a href="/rss.xml" class="m3-icon-btn" aria-label="RSS 订阅">
        <Icon name="rss" />
      </a>
      <a
        href="https://github.com/pizerolol/this-blog"
        class="m3-icon-btn"
        aria-label="GitHub 仓库"
      >
        <Icon name="github" />
      </a>
    </div>
  </header>

  <main class="mx-auto flex max-w-[64rem] flex-col gap-10 px-4 pb-16">
    <section
      class="m3-rise bg-primary-container text-on-primary-container rounded-3xl relative mt-2 overflow-hidden"
    >
      <div class="relative h-48 sm:h-72">
        <Picture
          src={luoxi}
          formats={["avif", "webp"]}
          widths={[640, 1024, 1536, 2048]}
          sizes="(min-width: 64rem) 64rem, 100vw"
          alt="窗边看书的狼耳少女插画"
          loading="eager"
          fetchpriority="high"
          quality={72}
          class="size-full object-cover object-[50%_32%]"
        />
        <div
          class="from-primary-container/60 pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t sm:h-24 to-transparent"
          aria-hidden="true"
        >
        </div>
        <span
          class="bg-on-primary-container text-primary-container ring-primary-container ease-spring absolute bottom-0 left-6 grid size-16 translate-y-1/2 -rotate-6 place-items-center rounded-xl font-mono text-lg font-bold ring-4 transition-transform duration-300 hover:rotate-3 sm:left-10"
        >
          &gt;_&lt;
        </span>
      </div>
      <div
        class="relative flex flex-col gap-6 px-6 pt-12 pb-6 sm:px-10 sm:pt-14 sm:pb-10"
      >
        <div
          class="bg-tertiary-container/40 pointer-events-none absolute -right-16 -bottom-24 size-64 rounded-full blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div class="relative flex flex-wrap items-center gap-4">
          <span
            class="text-label border-on-primary-container/30 rounded-full border px-3 py-1 tracking-widest uppercase"
          >
            Personal Blog
          </span>
        </div>
        <h1 class="text-display relative">Pizero</h1>
        <div class="relative flex max-w-[42rem] flex-col gap-3">
          <p class="text-on-primary-container/90">
            这个网名基本上就是一个随机数随机出来的，只要能确保指向的是我，怎么叫都行。
          </p>
          <p class="text-on-primary-container/90">
            学业上基本上就是混子，上课摸鱼摆烂，能多拿一分就一分，拿不到开摆。
          </p>
          <p class="text-on-primary-container/90">
            摸鱼摆烂乐子人，技校在读学生，会点前端/后端开发，偶尔写写代码。
          </p>
          <p class="text-on-primary-container/90">
            自主起的项目基本上没有，全是玩具，用的都是轮椅，喜欢 KISS
            和写一次性代码，突出一个能用就行。
          </p>
        </div>
        <div class="relative flex flex-wrap items-center gap-2">
          <OnlineStatus client:only="solidjs" />
          {
            config.links.map((i) => (
              <a href={i.link} class="m3-chip m3-chip-hero">
                {i.name}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="text-headline">博客</h2>
      <div class="flex flex-col gap-3">
        {
          visiblePosts.map((post, i) => (
            <div class="m3-rise" style={`animation-delay: ${80 + i * 50}ms`}>
              <PostBlock post={post} />
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="pb-10">
    <WebInfo />
  </footer>
</Base>
