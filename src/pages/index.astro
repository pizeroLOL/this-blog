---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import config from "../../indexConfig.json";
import Icon from "../components/Icon.astro";
import PostBlock from "../components/PostBlock.astro";
import Base from "../layouts/Base.astro";
import WebInfo from "../components/WebInfo.astro";
import OnlineStatus from "../components/solidjs/OnlineStatus";
import luoxi from "../assets/luoxi.jpg";

const posts = await getCollection("blogs");
const visiblePosts = (
  import.meta.env.DEV
    ? posts
    : posts.filter((post) => !post.data.tags.includes("测试"))
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base
  title="主页"
  description="Pizero 的个人博客"
  keywords={["blog", "pizero", "博客"]}
>
  <!-- 整页固定背景：滚动时 blur 升高、透明度降低（由页面底部脚本驱动） -->
  <div class="hero-bg" id="hero-bg" aria-hidden="true">
    <Picture
      src={luoxi}
      formats={["avif", "webp"]}
      widths={[640, 1024, 1536, 2048]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      quality={72}
    />
  </div>

  <header class="m3-top-bar">
    <div class="mx-auto flex h-16 max-w-[64rem] items-center gap-2 px-4">
      <a href="/" class="flex items-center gap-3" aria-label="pizero 首页">
        <span
          class="bg-primary-container text-on-primary-container grid size-9 place-items-center rounded-[10px] font-mono text-xs font-bold"
        >
          &gt;_&lt;
        </span>
        <span class="text-title">pizero</span>
      </a>
      <span class="flex-1"></span>
      <a href="/rss.xml" class="m3-icon-btn" aria-label="RSS 订阅">
        <Icon name="rss" />
      </a>
      <a
        href="https://github.com/pizerolol/this-blog"
        class="m3-icon-btn"
        aria-label="GitHub 仓库"
      >
        <Icon name="github" />
      </a>
    </div>
  </header>

  <main class="mx-auto flex max-w-[64rem] flex-col gap-10 px-4 pb-16">
    <section
      id="hero"
      class="m3-rise m3-glass text-on-surface rounded-3xl relative mt-2 p-6 sm:p-10"
    >
      <div class="flex flex-wrap items-center gap-4">
        <span
          class="bg-primary-container text-on-primary-container ease-spring grid size-14 shrink-0 -rotate-6 place-items-center rounded-xl font-mono text-lg font-bold transition-transform duration-300 hover:rotate-3"
        >
          &gt;_&lt;
        </span>
        <span
          class="text-label border-outline-variant text-on-surface-variant rounded-full border px-3 py-1 tracking-widest uppercase"
        >
          Personal Blog
        </span>
      </div>
      <h1 class="text-display text-primary mt-6">Pizero</h1>
      <div class="mt-6 flex max-w-[42rem] flex-col gap-3">
        <p class="text-on-surface-variant">
          这个网名基本上就是一个随机数随机出来的，只要能确保指向的是我，怎么叫都行。
        </p>
        <p class="text-on-surface-variant">
          学业上基本上就是混子，上课摸鱼摆烂，能多拿一分就一分，拿不到开摆。
        </p>
        <p class="text-on-surface-variant">
          摸鱼摆烂乐子人，技校在读学生，会点前端/后端开发，偶尔写写代码。
        </p>
        <p class="text-on-surface-variant">
          自主起的项目基本上没有，全是玩具，用的都是轮椅，喜欢 KISS
          和写一次性代码，突出一个能用就行。
        </p>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <OnlineStatus client:only="solidjs" />
        {
          config.links.map((i) => (
            <a href={i.link} class="m3-chip m3-chip-hero">
              {i.name}
            </a>
          ))
        }
      </div>
    </section>

    <section id="posts" class="flex flex-col gap-4">
      <h2
        class="text-headline bg-surface/80 w-fit rounded-2xl px-4 py-1 backdrop-blur-md"
      >
        博客
      </h2>
      <div class="flex flex-col gap-3">
        {
          visiblePosts.map((post, i) => (
            <div class="m3-rise" style={`animation-delay: ${80 + i * 50}ms`}>
              <PostBlock post={post} />
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="pb-10">
    <WebInfo />
  </footer>

  <script>
    // 滚动出 Hero 时，背景逐渐模糊并变淡（模拟 M3E 状态栏压暗 / 模糊）
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    const bg = document.getElementById("hero-bg");
    const hero = document.getElementById("hero");

    if (bg && hero && !reduceMotion) {
      const MAX_BLUR = 16;
      const MIN_ALPHA = 0.32;
      let frame = 0;

      const update = () => {
        frame = 0;
        const rect = hero.getBoundingClientRect();
        const raw = Math.min(
          1,
          Math.max(0, -rect.top / Math.max(1, rect.height))
        );
        // smoothstep：大部分变化发生在 Hero 快滚出视口时
        const t = raw * raw * (3 - 2 * raw);
        bg.style.setProperty("--hero-blur", `${(t * MAX_BLUR).toFixed(2)}px`);
        bg.style.setProperty(
          "--hero-alpha",
          `${(1 - t * (1 - MIN_ALPHA)).toFixed(3)}`
        );
      };

      const onScroll = () => {
        if (frame) return;
        frame = requestAnimationFrame(update);
      };

      addEventListener("scroll", onScroll, { passive: true });
      addEventListener("resize", onScroll);
      update();
    }
  </script>
</Base>
