---
import WebInfo from "../components/WebInfo.astro";
import Base from "../layouts/Base.astro";
---

<Base title="404" description="页面未找到">
  <main class="relative mx-auto flex min-h-dvh max-w-[64rem] flex-col px-4">
    <section class="m3-rise mt-[18dvh] flex flex-col items-start gap-6">
      <span
        class="bg-tertiary-container text-on-tertiary-container ease-spring grid size-16 rotate-6 place-items-center rounded-2xl font-mono text-base font-bold transition-transform duration-300 hover:-rotate-3"
      >
        QwQ
      </span>
      <h1 class="text-display">404</h1>
      <p class="text-title text-on-surface-variant">页面未找到</p>
      <a href="/" class="m3-btn m3-btn-filled"> 回到首页 </a>
    </section>
    <div class="mt-auto pb-10">
      <WebInfo />
    </div>
  </main>
</Base>
